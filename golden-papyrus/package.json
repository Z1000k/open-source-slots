{
  "name": "golden-papyrus",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "GOLDEN PAPYRUS - 5x3 Egyptian book slot with expanding free games (math ported from slotopol/server, MIT)",
  "scripts": {
